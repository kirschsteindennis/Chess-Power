@using System.Diagnostics

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    @* The trace of this request: the browser sends it back with its error reports *@
    @if (TraceParent is not null)
    {
        <meta name="traceparent" content="@TraceParent" />
    }
    @* First script: it also sees errors of the scripts that come after it *@
    <script src="@Assets["client-errors.js"]"></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["ChessUI.Teams.styles.css"]" />
    <link rel="stylesheet" href="@Assets["_content/ChessUI.Shared/chess.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="https://res.cdn.office.net/teams-js/2.32.1/js/MicrosoftTeams.min.js"></script>
    <script src="@Assets["teams-interop.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private static string TraceParent =>
            Activity.Current is { IdFormat: ActivityIdFormat.W3C } activity ? activity.Id : null;
}